# Frontend environment — sao chép thành `.env` (hoặc `.env.local`) rồi điền giá trị.
#
# Lấy ở: Firebase Console → Project settings → General → Your apps → SDK setup and configuration
#
# ⚠️ Web API key của Firebase KHÔNG phải mật khẩu: nó luôn nằm trong bundle JS mà
# trình duyệt tải về, ai xem source cũng thấy. Việc bảo vệ dữ liệu nằm ở
# `firestore.rules` (gốc repo) và ở phần giới hạn HTTP referrer của API key trên
# Google Cloud Console → APIs & Services → Credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Chỉ còn dùng cho backend REST cũ trong `backend/` (đã ngừng dùng).
VITE_API_BASE=
