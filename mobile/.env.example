# ── Firebase — BẮT BUỘC
# Lấy ở: Firebase Console → Project settings → General → Your apps → SDK setup and configuration
# (Dùng đúng giá trị đang đặt trong frontend/.env để app và web chung một project.)
#
# ⚠️ Web API key của Firebase không phải mật khẩu — nó luôn nằm trong bundle mà
# client tải về. Bảo vệ dữ liệu là việc của firestore.rules ở gốc repo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google OAuth (đồng bộ Google Calendar) — KHÔNG BẮT BUỘC
# Cứ để trống cũng được: mở app → Cài đặt → Google Calendar và dán Client ID
# thẳng vào đó. Giá trị lưu trong Firestore (users/{uid}/meta/prefs) nên đổi lúc
# nào cũng được, không phải build lại app. Ba dòng dưới chỉ là mặc định lúc build.
#
# Client ID là danh tính của app do Google cấp — app không tự lấy về được, phải
# tạo một lần tại: Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID. Nhớ bật "Google Calendar API" trong Library.
#
# Với Android chọn loại "Android" và khai:
#   Package name : com.tunglam.workspace
#   SHA-1        : lấy bằng lệnh dưới đây (bản release hiện ký bằng debug keystore)
#     keytool -list -v -keystore mobile/android/app/debug.keystore \
#       -storepass android -alias androiddebugkey | grep SHA1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
